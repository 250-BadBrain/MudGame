  "rooms": {
    "bronze_00": {
      "name": "西市旧货巷",
      "description": "洛阳西市夜深后只余檐角灯火。旧货摊主人早已不见，巷底却传来一声声低沉铜鸣，像有人在另一段年月里敲门。",
      "exits": {
        "east": "bronze_01"
      },
      "npcs": []
    },
    "bronze_01": {
      "name": "铜匣铺后堂",
      "description": "后堂桌上摆着一只战国铜匣，匣边有新鲜血迹，旁边压着半张拓片。匣身纹路并非死物，烛光一照，竟像活水般缓缓流动。",
      "exits": {
        "west": "bronze_00",
        "east": "bronze_02"
      },
      "npcs": []
    },
    "bronze_02": {
      "name": "机关暗格",
      "description": "铜匣底部露出一线暗格，里面隐约嵌着古铜残片。残片边缘锋利，似乎只要伸手触碰，就会割开眼前的洛阳夜色。",
      "exits": {
        "west": "bronze_01",
        "east": "zhao_road_03"
      },
      "actions": ["search"],
      "npcs": []
    },
    "zhao_road_03": {
      "name": "铜光裂隙",
      "description": "一步踏出，脚下青石变成黄土。风里有陌生的马汗与草灰味，身上衣物、佩饰、兵刃全都变了模样，远处有人惊呼：少龙在那里！",
      "exits": {
        "west": "bronze_02",
        "east": "village_04"
      },
      "npcs": []
    },
    "village_04": {
      "name": "赵境荒村",
      "description": "几户人家围着枯井，村口一名少女被恶霸拦住去路。她神情倔强，听见追兵喊出的名字后，目光里闪过一丝惊疑。",
      "exits": {
        "west": "zhao_road_03",
        "east": "zhao_road_05"
      },
      "npcs": ["tingfang_shadow", "zhao_bully"]
    },
    "zhao_road_05": {
      "name": "赵道伏击",
      "description": "土路两旁野草齐腰，马蹄声从坡后骤然逼近。赵国游骑勒马横刀，口中一声声喊着少龙，仿佛这个名字已经替你招来杀机。",
      "exits": {
        "west": "village_04",
        "east": "bamboo_06"
      },
      "npcs": ["zhao_rider", "zhao_rider"]
    },
    "bamboo_06": {
      "name": "竹影驿路",
      "description": "竹影斜落在古道上，婷芳氏低声说此去邯郸尚远，若想活命，便不能只凭一时勇气。你脑海里却浮起许多并非自己的判断。",
      "exits": {
        "west": "zhao_road_05",
        "east": "camp_07"
      },
      "npcs": ["tingfang_shadow"]
    },
    "camp_07": {
      "name": "废弃驿营",
      "description": "驿营火堆将熄，地上有仓促撤离的车辙。几名追兵翻找残帐，像是在找一件比人命更要紧的东西。",
      "exits": {
        "west": "bamboo_06",
        "east": "camp_08"
      },
      "npcs": ["zhao_rider", "zhao_retainer"]
    },
    "camp_08": {
      "name": "残帐书案",
      "description": "书案半塌，竹简散落一地，其中一页残简压在铜扣下。简上残字断续，隐约牵出邯郸、质子和少龙几个名字。",
      "exits": {
        "west": "camp_07",
        "east": "pass_09"
      },
      "actions": ["inspect_fragment"],
      "npcs": []
    },
    "pass_09": {
      "name": "归途断桥",
      "description": "断桥横在枯水沟上，桥头立着一名门客剑士。他并不急着出剑，只冷冷道：能乱时局的异数，不能带着残简活着离开。",
      "exits": {
        "west": "camp_08",
        "east": "gate_09"
      },
      "npcs": ["retainer_swordsman"]
    },
    "gate_09": {
      "name": "铜门残响",
      "description": "铜光在断桥尽头重新聚合成门。风沙中有人喊着少龙往邯郸去，那声音像来自身后，又像从你自己的记忆里响起。",
      "exits": {
        "west": "pass_09"
      },
      "npcs": []
    }
  }
}
