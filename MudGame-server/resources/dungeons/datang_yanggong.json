  "puzzleActions": {
    "turn_mechanism": {
      "label": "转动机关盘",
      "puzzleId": "mechanism",
      "rooms": [
        "vault_01"
      ],
      "fromStates": [
        "locked"
      ],
      "nextState": "open",
      "message": "你依着鲁妙子留下的刻痕转动机关盘，铜轮咬合之声层层传来，殿北石门缓缓升起。",
      "repeatMessage": "机关盘已经停当，石门敞开着。"
    },
    "solve_chess": {
      "label": "落子破局",
      "puzzleId": "chess",
      "rooms": [
        "vault_03"
      ],
      "fromStates": [
        "unsolved"
      ],
      "nextState": "solved",
      "message": "枰上黑白之势看似必死，你忽然省起鲁妙子批注的八个字：\"弃子争先，以拙破巧。\"一子落枰，满枰石机倒转，北门应声而开。",
      "repeatMessage": "棋局已破，枰上残子再无变化。"
    },
    "read_annotation": {
      "label": "研读鲁妙子批注",
      "puzzleId": "annotation",
      "rooms": [
        "vault_03"
      ],
      "fromStates": [
        "unread"
      ],
      "nextState": "read",
      "message": "你凑近门楣上\"弃子争先，以拙破巧\"的批注，逐字玩味——批注背后竟还藏着一套读书悟道的法门，《悟真篇》残页赫然在目。",
      "repeatMessage": "批注你早已烂熟于心。",
      "giveItems": {
        "wuzhen_page": 1
      }
    }
  },
